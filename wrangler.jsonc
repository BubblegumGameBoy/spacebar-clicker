{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spacebar-clicker-ranking-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spacebar-clicker-leaderboard",
      "database_id": "dc885e33-8630-4fd1-99d0-ca08f4d599b4",
      "migrations_dir": "migrations"
    }
  ]
}
